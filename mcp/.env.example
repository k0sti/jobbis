# Työmarkkinatori API Credentials
# Obtain these from KEHA Centre by emailing: tmt-rajapinnat.keha@ely-keskus.fi

# OAuth 2.0 Client Credentials (Required)
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
TENANT_ID=your-tenant-id-here

# API Configuration
# Production endpoint
API_BASE_URL=https://integraatiot.tyomarkkinatori.fi

# For testing, use QA endpoint instead:
# API_BASE_URL=https://integraatiot-qa.tyomarkkinatori.fi

# Optional: Cache settings
# Cache TTL in milliseconds (default: 900000 = 15 minutes)
CACHE_TTL_MS=900000

# Optional: Rate limiting
# Requests per second (default: 2)
RATE_LIMIT_RPS=2
# Maximum burst capacity (default: 10)
RATE_LIMIT_BURST=10

# Optional: Environment
NODE_ENV=production
