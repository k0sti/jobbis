# OAuth 2.0 credentials (required)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Environment: production, test, qa, or development (optional, default: production)
# This automatically sets the correct TOKEN_URL, OAUTH_SCOPE, and API_BASE_URL
ENVIRONMENT=production

# Or manually override (optional - only if you need custom values):
# TOKEN_URL=https://tedigib2c.b2clogin.com/tedigib2c.onmicrosoft.com/B2C_1A_SIGNIN/oauth2/v2.0/token
# OAUTH_SCOPE=https://tedigib2c.onmicrosoft.com/e9343614-0f96-437e-9f5e-1d392e756675/.default
# API_BASE_URL=https://integraatiot.tyomarkkinatori.fi

# Cache TTL in milliseconds (optional, default: 900000 = 15 minutes)
CACHE_TTL_MS=900000

# Rate limiting (optional)
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10
